{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./demo/*"],
      "easybill-ui/*": ["./packages/easybill-ui/*"]
    }
  },
  "include": ["demo/**/*.ts", "demo/**/*.tsx", "demo/**/*.vue", "packages/easybill-ui/**/*.ts", "packages/easybill-ui/**/*.tsx", "packages/easybill-ui/**/*.vue"]
}
